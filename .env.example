# Copy to .env and fill in. .env is gitignored; never commit it.

# LLM: Ollama, running natively in Ubuntu (issue #26). The model is issue #6's pick.
LLM_PROVIDER=ollama
# Ollama's default, from `ollama serve --help`: "default 127.0.0.1:11434".
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen3:4b-instruct-2507-q4_K_M

# Where the agent listens for AudioSocket: loopback only, so nothing on the Wi-Fi reaches it.
# Asterisk, in its container, dials host.docker.internal:9092 to get here (#27); the port must
# match extension 3100 in asterisk/config/extensions.conf. Empty means 127.0.0.1:9092.
AUDIOSOCKET_LISTEN=127.0.0.1:9092
# Where the agent reaches AMI, to transfer an escalated call (issue #20). `make asterisk-up`
# fills in empty ones: host 127.0.0.1, username checkin-agent, and a long random secret it keeps
# after that. AMI's port defaults to 5038 (include/asterisk/manager.h:58).
AMI_HOST=
AMI_PORT=5038
AMI_USERNAME=
AMI_SECRET=

# The dispatcher softphone's extension. Escalations transfer here, never to an outside number:
# the agent refuses to start with anything but digits, or with an emergency number. When the
# resident calls from 2000 itself, point this at another phone, e.g. 1001.
DISPATCHER_EXTENSION=2000

# Outbound check-ins (issue #22). The residents, by extension, comma-separated: whom the agent
# calls. Each must be digits and never an emergency number, or the agent refuses to start.
RESIDENTS=1001
# Repeat a round of check-ins every this many minutes while the agent runs. Empty: none, only
# the round `make checkin` starts at once.
CHECKIN_EVERY_MIN=
# Each check-in: this many attempts, this many seconds apart (from the end of a missed attempt
# to the next), each ringing this many seconds. When every attempt is missed, a missed check-in
# alert goes to the dispatcher (a mock: printed, and written to calls/check-in-*.json).
CHECKIN_ATTEMPTS=3
CHECKIN_RETRY_AFTER_S=120
CHECKIN_RING_S=30

# The two phones' SIP passwords. `make asterisk-up` fills in an empty one with a long random
# password and keeps it after that; empty one to get a new one. `make sip-accounts` prints what
# to type into the softphones.
SIP_1001_PASSWORD=
SIP_2000_PASSWORD=
# The laptop's Wi-Fi address, which the phones dial. Leave empty to read it from Windows on
# every `make asterisk-up`. Set it only if that picks the wrong network, a VPN for example.
LAN_IP=

# One JSON log per call is written here (gitignored).
CALLS_DIR=calls
# on: record each call, both sides, as <call>.wav next to its log (stereo, 8 kHz: the resident
# left, the agent right). Off by default: a recording holds a real voice.
RECORD_CALLS=
