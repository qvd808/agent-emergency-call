# Copy to .env and fill in. .env is gitignored; never commit it.

# LLM: Ollama, running natively in Ubuntu (issue #26). The model is issue #6's pick.
LLM_PROVIDER=ollama
# Ollama's default, from `ollama serve --help`: "default 127.0.0.1:11434".
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen3:4b-instruct-2507-q4_K_M

# Where the agent listens for AudioSocket, and where it reaches AMI. Left empty until
# "How do Asterisk under Docker Desktop and the agent in Ubuntu reach each other?" (#27)
# decides the addresses. AMI's port defaults to 5038 (include/asterisk/manager.h:58).
AUDIOSOCKET_LISTEN=
AMI_HOST=
AMI_PORT=5038
AMI_USERNAME=
AMI_SECRET=

# The dispatcher softphone's extension. Escalations transfer here, never to an outside number.
DISPATCHER_EXTENSION=2000

# The two phones' SIP passwords. `make asterisk-up` fills in an empty one with a long random
# password and keeps it after that; empty one to get a new one. `make sip-accounts` prints what
# to type into the softphones.
SIP_1001_PASSWORD=
SIP_2000_PASSWORD=
# The laptop's Wi-Fi address, which the phones dial. Leave empty to read it from Windows on
# every `make asterisk-up`. Set it only if that picks the wrong network, a VPN for example.
LAN_IP=

# One JSON log per call is written here (gitignored).
CALLS_DIR=calls
